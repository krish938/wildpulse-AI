# ============================================================
# WildPulse AI — Backend Environment Variables
# ============================================================
# SETUP:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in all <placeholder> values below.
#   3. NEVER commit .env to version control.
# ============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────
# How to get this:
#   1. Go to https://cloud.mongodb.com
#   2. Create a free cluster (M0 Sandbox — no credit card needed)
#   3. Under "Database Access", create a user with readWrite permissions
#   4. Under "Network Access", add your IP (or 0.0.0.0/0 for development)
#   5. Click "Connect" → "Connect your application" → copy the URI
#   6. Replace <username>, <password>, and <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wildpulse?retryWrites=true&w=majority

# ─── NASA FIRMS API ──────────────────────────────────────────
# Real-time satellite fire detection data.
# Register at: https://firms.modaps.eosdis.nasa.gov/api/
# After registration, your MAP_KEY is on your account dashboard.
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Dataset options: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT
NASA_FIRMS_DATASET=VIIRS_SNPP_NRT

# Number of past days to retrieve fire data for (1–10)
NASA_FIRMS_DAYS=1

# ─── Frontend CORS ───────────────────────────────────────────
# The URL of the frontend dev server. Must match exactly.
# Default: http://localhost:5173 (Vite default port)
FRONTEND_URL=http://localhost:5173

